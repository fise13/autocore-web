[package]
name = "tauri-plugin-siwa"
version = "1.0.0"
authors = ["Manaf941", "GavynStanley"]
description = "Sign In with Apple for Tauri 2 — supports iOS and macOS."
license = "MIT"
edition = "2021"
rust-version = "1.77.2"
readme = "README.md"
repository = "https://github.com/GavynStanley/tauri-plugin-siwa"
keywords = ["tauri", "apple", "sign-in", "ios", "macos"]
categories = ["authentication"]
exclude = ["/examples", "/webview-dist", "/webview-src", "/node_modules"]
links = "tauri-plugin-siwa"

[lib]
name = "tauri_plugin_siwa"
path = "src/lib.rs"
crate-type = ["staticlib", "cdylib", "rlib"]

[dependencies]
tauri = { version = "2.1.0" }
serde = "1.0"
thiserror = "2"

[target.'cfg(target_os = "macos")'.dependencies]
serde_json = "1.0"
swift-rs = "1.0"

[build-dependencies]
tauri-plugin = { version = "2.0.2", features = ["build"] }

[target.'cfg(target_os = "macos")'.build-dependencies]
swift-rs = { version = "1.0", features = ["build"] }
