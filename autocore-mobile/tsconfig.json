{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@autocore/billing": ["../packages/billing/src"],
      "@autocore/billing/*": ["../packages/billing/src/*"],
      "@autocore/rbac": [
        "../packages/rbac/src"
      ],
      "@autocore/rbac/*": [
        "../packages/rbac/src/*"
      ],
      "@autocore/domain-search": [
        "../packages/domain-search/src"
      ],
      "@autocore/domain-search/*": [
        "../packages/domain-search/src/*"
      ],
      "@autocore/org": [
        "../packages/org/src"
      ],
      "@autocore/org/*": [
        "../packages/org/src/*"
      ],
      "@autocore/avatars": [
        "../packages/avatars/src"
      ],
      "@autocore/design-tokens": [
        "../packages/design-tokens/src"
      ],
      "@autocore/design-tokens/*": [
        "../packages/design-tokens/src/*"
      ],
      "@autocore/avatars/*": [
        "../packages/avatars/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "**/*.test.ts"
  ]
}