# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# Apple signing keys (App Store Server API, Sign in with Apple, APNs)
*.p8
AuthKey_*.p8

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local AI agents and editor instructions
**/.agents/
**/.cursor/
**/.claude/
**/.codex/
**/.continue/
**/.windsurf/
**/AGENTS.md
**/CLAUDE.md
**/GEMINI.md
**/skills-lock.json
**/.aider*

# env files
.env*
!.env.local.example
!.env.vercel.example
!.env.desktop.example
firebase/functions/.env

# generated Firebase Functions output
firebase/functions/lib/

# local acquisition and presentation artifacts
/AutoCore_Investor_Deck_*.pdf
/src/components/*.pdf
/docs/investor-deck/generated/

# Firebase service account keys (never commit)
*-firebase-adminsdk-*.json
service-account*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# apple oauth forensic artifacts
scripts/.apple-auth-code.json

# rendered email previews (npm run email:preview)
/.email-preview/

# tauri desktop
/src-tauri/target/
/src-tauri/gen/
/src-tauri/resources/next-server/
