{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@assets/*": [
        "./assets/*"
      ],
      "@autocore/types": [
        "./autocore-desktop/packages/types/src"
      ],
      "@autocore/types/*": [
        "./autocore-desktop/packages/types/src/*"
      ],
      "@autocore/rbac": [
        "./packages/rbac/src"
      ],
      "@autocore/rbac/*": [
        "./packages/rbac/src/*"
      ],
      "@autocore/domain-search": [
        "./packages/domain-search/src"
      ],
      "@autocore/domain-search/*": [
        "./packages/domain-search/src/*"
      ],
      "@autocore/org": [
        "./packages/org/src"
      ],
      "@autocore/org/*": [
        "./packages/org/src/*"
      ],
      "@autocore/avatars": [
        "./packages/avatars/src"
      ],
      "@autocore/avatars/*": [
        "./packages/avatars/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "firebase/functions",
    "autocore-desktop",
    "autocore-mobile"
  ]
}
