NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_APPLE_WEB_CLIENT_ID=com.wise.autocore.web
# apple_js (default) | firebase_handler
NEXT_PUBLIC_APPLE_AUTH_MODE=apple_js
# Apple JS: redirect by default. Popup only if NEXT_PUBLIC_APPLE_JS_USE_POPUP=true
# NEXT_PUBLIC_APPLE_JS_USE_POPUP=true
# Apple JS redirect Return URL (optional override). Default: <current-origin>/login
# Must match Apple Developer → Services ID → Return URLs exactly.
# NEXT_PUBLIC_APPLE_JS_REDIRECT_URI=https://your-app.vercel.app/login

# App URL for Stripe Checkout return links (web). On Vercel set to production domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Apple JS local dev — Apple Developer rejects "localhost" in Domains. Use hosts alias:
#   sudo sh -c 'echo "127.0.0.1 local.autocore.dev" >> /etc/hosts'
#   NEXT_PUBLIC_APP_URL=http://local.autocore.dev:3000
# Apple Developer: Domain local.autocore.dev, Return URL http://local.autocore.dev:3000/login
# Or deploy to Vercel and register https://your-app.vercel.app/login
# Production split (recommended):
# NEXT_PUBLIC_MARKETING_URL=https://myautocore.com
# NEXT_PUBLIC_APP_URL=https://app.myautocore.com
# Marketing: myautocore.com (/, /product, /pricing…)
# App: app.myautocore.com (/login, /warehouse…)
#
# Local / single-host preview (app + marketing on one origin): set BOTH URLs to the same host.
# App owns `/` (Overview), /login, /warehouse… Marketing: /marketing, /pricing, /product…
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=https://autocore-web.vercel.app
# NEXT_PUBLIC_MARKETING_URL=https://autocore-web.vercel.app
#
# Full Vercel env checklist: see .env.vercel.example

# --- Firebase Admin (продажа моторов, PDF, API) ---
# Локально: скачайте ключ из Firebase Console → Service accounts,
# положите *-firebase-adminsdk-*.json в корень проекта (файл в .gitignore):
# FIREBASE_SERVICE_ACCOUNT_PATH=./autocore-6066c-firebase-adminsdk-fbsvc-xxxx.json
# PDF locally uses Puppeteer — Chrome installs automatically on first `npm run dev` (predev hook).
# Optional override when dev server runs on another host/port:
# PDF_RENDER_BASE_URL=http://127.0.0.1:3000
# Shared secret for background document worker (Next.js + Firebase Functions):
# DOCUMENT_WORKER_SECRET=generate-a-long-random-string
# Local/dev: kick runs PDF jobs inline — secret optional. Production: set DOCUMENT_WORKER_SECRET.
DOCUMENT_WORKER_SECRET=autocore-local-document-worker-secret-dev
# FIREBASE_STORAGE_BUCKET=autocore-6066c.firebasestorage.app
# Vercel: FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional: custom Spline 3D scene for marketing hero (scene.splinecode URL from spline.design)
# NEXT_PUBLIC_SPLINE_HERO_SCENE=https://prod.spline.design/your-scene/scene.splinecode

# Stripe Price IDs (test mode — from Product catalog export)
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=price_1TbiZUHo5bmy0A9LC86I6wJJ
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY=price_1TbiarHo5bmy0A9LD3SafymR
NEXT_PUBLIC_STRIPE_PRICE_FREE=price_1TbiblHo5bmy0A9Lc8CwYfit

# Demo account — one-click «Попробовать демо» from marketing
# With FIREBASE_SERVICE_ACCOUNT_PATH (or JSON on Vercel) the account is created automatically on first visit.
# Optional password fallback when Admin SDK is unavailable:
DEMO_ACCOUNT_EMAIL=demo@autocore.app
# DEMO_ACCOUNT_PASSWORD=your-secure-demo-password

# --- Desktop (Tauri shell → Vercel) ---
# NEXT_PUBLIC_DESKTOP_DOWNLOAD_MAC=https://myautocore.com/downloads/AutoCore-mac.dmg
# NEXT_PUBLIC_DESKTOP_DOWNLOAD_WIN=https://myautocore.com/downloads/AutoCore-windows.exe
# NEXT_PUBLIC_DESKTOP_DOWNLOADS_BASE_URL=https://myautocore.com

# --- Mobile (marketing /download/mobile) ---
# NEXT_PUBLIC_MOBILE_DOWNLOAD_IOS=https://apps.apple.com/...
# NEXT_PUBLIC_MOBILE_DOWNLOAD_ANDROID=https://play.google.com/...

# --- Public contacts (marketing footer, /contact, SEO) ---
NEXT_PUBLIC_AUTOCORE_SUPPORT_PHONE=+77471795869
NEXT_PUBLIC_AUTOCORE_SUPPORT_EMAIL=support@myautocore.com

# Optional external status page (Better Stack, Instatus, etc.)
# Leave empty to use built-in /status inside the app.
# NEXT_PUBLIC_AUTOCORE_STATUS_URL=https://status.myautocore.com

# --- Email (Resend) — server-only ---
# RESEND_API_KEY=
# Auth emails (verification, password reset)
# RESEND_NOREPLY_EMAIL=AutoCore <noreply@myautocore.com>
# Team invites
# RESEND_FROM_EMAIL=AutoCore <support@myautocore.com>

# Required in production for PDF render tokens (min 32 random chars).
# Local dev: any 32+ char string is fine.
DOCUMENT_RENDER_SECRET=autocore-local-document-render-secret-dev

# AI — local OpenRouter (Core assistant, scan OCR, import, label polish)
# -----------------------------------------------------------------------------
# Local: put the OpenRouter key here so Next.js calls
#   https://openrouter.ai/api/v1/chat/completions
# directly (preferred whenever OPENROUTER_API_KEY is set).
# Production: omit the key on Vercel — Functions openrouterProxy holds it.
#
# Gemini / general OpenRouter (scan, import, document polish):
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=google/gemini-2.5-flash
# SCAN_AI_MODEL=google/gemini-2.0-flash-001
# IMPORT_AI_MODEL=google/gemini-2.0-flash-001
# DOCUMENT_AI_MODEL=google/gemini-2.0-flash-001
#
# Core agent (multi-step tools). Defaults to google/gemini-2.5-flash on any
# direct OpenRouter key. Prefer a paid/reliable model — free NVIDIA tiers hit
# ResourceExhausted mid-loop and abort after tools already ran.
# CORE_AI_MODEL=google/gemini-2.5-flash
#
# Optional separate OpenRouter key so Core billing stays off the scan/import key:
# NVIDIA_OPENROUTER_API_KEY=sk-or-v1-...
# NVIDIA_AI_MODEL is for the JSON NVIDIA path only (not Core). Free Nemotron is
# unstable for Core multi-step — set CORE_AI_MODEL explicitly if you want it:
# NVIDIA_AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# CORE_AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
#
# Prod streaming (gen-2 Firebase proxy). Without this, Core falls back to the
# buffered gen-1 openrouterProxy + simulated streaming:
# CORE_STREAM_PROXY_URL=https://…cloudfunctions.net/openrouterStreamProxy
#
# Optional proxy overrides (prod / no local key): AI_PROXY_URL=...  AI_PROXY_SECRET=...

# Server-only Stripe secret for Firebase Functions (firebase/functions/.env, gitignored).
# Next.js only needs NEXT_PUBLIC_STRIPE_PRICE_* — no STRIPE_SECRET_KEY here.
#
# One-time local setup:
#   STRIPE_SECRET_KEY=sk_test_... npm run setup:stripe-secret
#
# Deploy callables (writes .env if STRIPE_SECRET_KEY is in shell env):
#   STRIPE_SECRET_KEY=sk_test_... npm run deploy:billing-functions
