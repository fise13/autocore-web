# AutoCore Desktop (Tauri) — build-time configuration.
#
# The desktop app is the same Next.js application as the web product, hosted in a
# native window. There is no separate frontend build, so the only thing the shell
# needs to know is which origin to load.
#
# Nothing in this file is a secret, and nothing secret may be added to it: a
# desktop bundle ships to users and its contents can be extracted. Firebase
# service-account keys, Stripe keys, the updater signing key and any other server
# credential belong in Vercel / Firebase / CI only.

# ---------------------------------------------------------------------------
# Which origin the shell loads
# ---------------------------------------------------------------------------
# Defaults to NEXT_PUBLIC_APP_URL from .env.local, or https://app.myautocore.com.
# Point this at http://localhost:3000 to develop against `npm run dev` — debug
# builds grant localhost a capability that release builds never carry.
# DESKTOP_APP_URL=https://app.myautocore.com

# ---------------------------------------------------------------------------
# Auto-update (optional; set both or neither)
# ---------------------------------------------------------------------------
# Consumed by scripts/tauri-build.mjs and passed to the Tauri CLI as a --config
# patch, so they are never written into tauri.conf.json. Without them the build
# has no updater and the app reports updaterEnabled: false.
# TAURI_UPDATER_ENDPOINT=https://myautocore.com/api/desktop/updates/{{target}}/{{arch}}/{{current_version}}
# TAURI_UPDATER_PUBKEY=<minisign public key from `npx tauri signer generate`>

# The matching PRIVATE key is a CI secret. Never place it in this file, in
# .env.local, or anywhere in the repository:
#   TAURI_SIGNING_PRIVATE_KEY
#   TAURI_SIGNING_PRIVATE_KEY_PASSWORD

# ---------------------------------------------------------------------------
# macOS signing / notarization (CI only)
# ---------------------------------------------------------------------------
# APPLE_CERTIFICATE, APPLE_CERTIFICATE_PASSWORD, APPLE_SIGNING_IDENTITY,
# APPLE_ID, APPLE_PASSWORD, APPLE_TEAM_ID — see docs/DESKTOP-RELEASE.md.

# ---------------------------------------------------------------------------
# Marketing download links (after npm run tauri:publish-downloads)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_DESKTOP_DOWNLOAD_MAC=https://myautocore.com/downloads/AutoCore-mac.dmg
# NEXT_PUBLIC_DESKTOP_DOWNLOAD_WIN=https://myautocore.com/downloads/AutoCore-windows.exe
