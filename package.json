{
  "name": "autocore-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "npm run tokens:build && node scripts/ensure-puppeteer-browser.mjs",
    "email:preview": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/email/preview-emails.mjs",
    "email:send": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/email/send-preview.mjs",
    "tokens:build": "node --import tsx scripts/design-tokens/build-css.mjs",
    "tokens:check": "node --import tsx scripts/design-tokens/build-css.mjs --check && node --import tsx scripts/design-tokens/check-contrast.mjs",
    "dev": "next dev",
    "insta:dev": "node insta-demo/server.mjs",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "prebuild": "npm run tokens:build && python3 scripts/generate-favicon-ico.py && node scripts/build-documents-css.mjs",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:i18n": "node --import tsx --test packages/i18n/src/**/*.test.ts",
    "i18n:validate": "node scripts/i18n/validate-messages.mjs",
    "i18n:check": "npm run i18n:validate && npm run test:i18n",
    "migrate:rbac": "tsx scripts/migrate-rbac.ts",
    "migrate:billing": "tsx scripts/backfill-billing-subscriptions.ts",
    "backfill:notifications": "tsx scripts/backfill-team-notifications.ts",
    "deploy:billing-functions": "bash scripts/deploy-billing-functions.sh",
    "setup:stripe-secret": "bash scripts/setup-stripe-firebase-secret.sh",
    "setup:apple-iap": "node scripts/setup-apple-iap-keys.mjs",
    "assets:sync-from-native": "bash scripts/sync-brand-assets-from-native.sh",
    "assets:generate-favicon": "python3 scripts/generate-favicon-ico.py",
    "build:documents-css": "node scripts/build-documents-css.mjs",
    "generate:document-templates": "node scripts/generate-document-templates.mjs",
    "install:browser": "npx puppeteer browsers install chrome",
    "test:scan": "node --import tsx --test src/lib/mobile/scan-normalize.test.ts",
    "e2e:smoke": "node scripts/e2e-smoke-checklist.mjs",
    "scan:export-events": "node --import tsx scripts/export-scan-events.mjs",
    "tauri:sync-url": "node scripts/sync-tauri-app-url.mjs",
    "tauri": "tauri",
    "tauri:dev": "node scripts/sync-tauri-app-url.mjs && tauri dev",
    "tauri:build": "node scripts/tauri-build.mjs",
    "tauri:build:mac": "node scripts/tauri-build.mjs --target aarch64-apple-darwin",
    "tauri:build:mac-intel": "node scripts/tauri-build.mjs --target x86_64-apple-darwin",
    "tauri:build:win": "node scripts/tauri-build.mjs --target x86_64-pc-windows-msvc",
    "tauri:publish-downloads": "node scripts/copy-tauri-downloads.mjs",
    "test:list": "node scripts/run-tests.mjs --list",
    "tauri:test": "cargo test --manifest-path src-tauri/Cargo.toml --lib"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.28",
    "@ai-sdk/react": "^4.0.61",
    "@barba/core": "^2.10.3",
    "@base-ui/react": "^1.5.0",
    "@gsap/react": "^2.1.2",
    "@paddle/paddle-js": "^1.6.4",
    "@paddle/paddle-node-sdk": "^3.10.0",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@sparticuz/chromium": "^149.0.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-query-devtools": "^5.100.14",
    "@tanstack/react-virtual": "^3.13.26",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.5",
    "ai": "^7.0.58",
    "animejs": "^4.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cobe": "^2.0.1",
    "date-fns": "^4.3.0",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.5.0",
    "gsap": "^3.15.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "nanoid": "^6.0.1",
    "next": "^16.2.6",
    "next-intl": "^4.13.3",
    "next-themes": "^0.4.6",
    "puppeteer-core": "^25.1.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-zoom-pan-pinch": "^4.0.3",
    "recharts": "^3.8.0",
    "resend": "^6.12.4",
    "server-only": "^0.0.1",
    "shadcn": "^4.8.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tauri-plugin-siwa-api": "^1.0.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "web-vitals": "^5.3.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.9",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sharp": "^0.31.1",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "firebase-tools": "^13.29.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
